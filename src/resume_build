#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml", "jinja2"]
# ///

import yaml
from jinja2 import Environment, FileSystemLoader

def load_styles(style_path):
    with open(style_path, "r", encoding="utf-8") as f:
        styles = f.read()
    return styles

def load_print_styles(print_path):
    with open(print_path, "r", encoding="utf-8") as f:
        styles = f.read()
    return styles


# Load YAML dataset
def load_data(yaml_path):
    with open(yaml_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
    return data

# Initialize Jinja2 environment
def get_jinja_template(template_path):
    env = Environment(loader=FileSystemLoader("."), autoescape=True)
    template = env.get_template(template_path)
    return template

# Output rendered result
def output_result(output_path, content):
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"Successfully generated {output_path}")


def generate_resume(yaml_path="data/resume_data.yml", template_path="views/resume_template.html.j2", style_path="css/styles.css", output_path="index.html"):
    # get data
    data = load_data(yaml_path)
    # get styles 
    styles = load_styles(style_path)
    # get print styles 
    print_styles = load_print_styles("css/print.css")

    # get template
    template = get_jinja_template(template_path)

    # add styles to template data
    data["css"] = styles
    data["print_styles"] = print_styles

    # TODO add favicon and js?

    # Render data into template
    rendered_html = template.render(**data)

    output_result(output_path, rendered_html)


if __name__ == "__main__":
    generate_resume()


